{
    "name": "o5/grido",
    "type": "library",
    "description": "Grido - DataGrid for Nette Framework",
    "keywords": ["datagrid", "datalist", "tablegrid", "grid", "list", "table", "nette"],
    "homepage": "http://o5.github.io/grido-examples/",
    "license": ["MIT"],
    "authors": [{
        "name": "Petr Bugyík",
        "homepage": "http://petr.bugyik.cz/"
    }],
    "support": {
        "issues": "https://github.com/o5/grido/issues/",
        "forum": "http://forum.nette.org/cs/13109-grido-datagrid-pro-nette/"
    },
    "autoload": {
        "psr-4": {
            "Grido\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grido\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "./vendor/bin/tester --colors 1 -j 4 -c tests/php-unix.ini -p php tests/",
        "syntax": "./vendor/bin/phpcs --standard=standards.xml --colors --encoding=utf-8 -sp src/",
        "syntax-fix": "./vendor/bin/phpcbf --standard=standards.xml src/",
        "phpstan": "vendor/bin/phpstan analyse --ansi",
        "ecs": "vendor/bin/ecs check --ansi",
        "ecs-fix": "vendor/bin/ecs check --fix --ansi",
        "rector": "vendor/bin/rector process --dry-run --ansi",
        "rector-fix": "vendor/bin/rector process --ansi"
    },
    "require": {
        "latte/latte": "^2.5 || ^3.0",
        "nette/application": "^3.0",
        "nette/component-model": "^3.0",
        "nette/forms": "^3.0",
        "nette/utils": "^3.0 || ^4.0",
        "php": "8.0 - 8.3",
        "symfony/property-access": "^6.0"
    },
    "require-dev": {
        "dibi/dibi": "^4.0 || ^5.0",
        "kdyby/console": "dev-master",
        "kdyby/events": "dev-master",
        "mockery/mockery": "^1.0",
        "nette/bootstrap": "^3.0",
        "nette/database": "^3.0",
        "nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^1.2",
        "rector/rector": "^1.0.0",
		"symplify/easy-coding-standard": "^12.0",
		"tomasvotruba/type-coverage": "dev-main",
        "tracy/tracy": "^2.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}